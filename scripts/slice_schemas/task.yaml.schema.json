{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task YAML Schema",
  "type": "object",
  "required": [
    "task_id",
    "task_local_id",
    "slice_id",
    "run_id",
    "task_revision",
    "title",
    "type",
    "repository_mode",
    "repo_target",
    "base",
    "write_scope",
    "acceptance",
    "verification"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "task_local_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,}$"},
    "slice_id": {"type": "string"},
    "run_id": {"type": "string"},
    "task_revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "type": {"enum": ["backend", "frontend", "test", "review", "arch", "ops", "migration"]},
    "repository_mode": {"enum": ["TRANSITIONAL_SUBMODULES", "TARGET_MONOREPO"]},
    "repo_target": {"type": "string"},
    "base": {
      "type": "object",
      "required": ["branch", "commit", "run_definition_revision", "spec_version", "contract_version"],
      "properties": {
        "branch": {"type": "string"},
        "commit": {"type": "string"},
        "run_definition_revision": {"type": "integer", "minimum": 1},
        "spec_version": {"type": "string"},
        "contract_version": {"type": "string"}
      }
    },
    "write_scope": {
      "type": "object",
      "required": ["allow", "deny"],
      "properties": {
        "allow": {"type": "array", "items": {"type": "string"}},
        "deny": {"type": "array", "items": {"type": "string"}}
      }
    },
    "acceptance": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "items": {"type": "string"}}
  }
}
